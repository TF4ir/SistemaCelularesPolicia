@model IEnumerable<SistemaCelularesPolicia.Models.Dependencia>

@{
    ViewData["Title"] = "Catálogo de Unidades";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-police fw-bold">Unidades y Dependencias</h2>
            <p class="text-muted">Gestión del catálogo de comisarías y divisiones policiales.</p>
        </div>
        <a asp-action="Upsert" class="btn btn-police shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nueva Unidad
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body py-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="busqueda" class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre, siglas o provincia..." value="@ViewData["BusquedaActual"]" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">Buscar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Nombre de Unidad</th>
                            <th class="text-secondary text-uppercase small fw-bold">Siglas</th>
                            <th class="text-secondary text-uppercase small fw-bold">Provincia</th>
                            <th class="text-secondary text-uppercase small fw-bold">Estado</th>
                            <th class="text-end pe-4 text-secondary text-uppercase small fw-bold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No se encontraron dependencias registradas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@item.Nombre</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Siglas))
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.Siglas</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="d-flex align-items-center">
                                            <i class="bi bi-geo-alt text-muted me-2 small"></i> @item.Provincia
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Activa)
                                        {
                                            <span class="badge bg-success bg-opacity-75 rounded-pill"><i class="bi bi-check-circle me-1"></i> Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-75 rounded-pill"><i class="bi bi-x-circle me-1"></i> Inactiva</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Upsert" asp-route-id="@item.IdDependencia" class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@model SistemaCelularesPolicia.Models.Dependencia

@{
    ViewData["Title"] = Model.IdDependencia == 0 ? "Nueva Unidad" : "Editar Unidad";
}

<div class="container mt-4 mb-5" style="max-width: 800px;">
    <form asp-action="Upsert" method="post">
        <input type="hidden" asp-for="IdDependencia" />

        <div class="card shadow border-0 overflow-hidden">
            <div class="card-header bg-police text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-building-fill me-2"></i>
                    @(Model.IdDependencia == 0 ? "Registrar Nueva Dependencia" : "Editar Datos de la Unidad")
                </h5>
                <small class="opacity-75">Complete la información oficial de la unidad policial.</small>
            </div>

            <div class="card-body p-4">
                
                <h6 class="text-police fw-bold mb-3 border-bottom pb-2">
                    <i class="bi bi-card-heading me-1"></i> Información General
                </h6>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted">Nombre Oficial <span class="text-danger">*</span></label>
                    <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej: COMISARÍA PNP HUANCAYO" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">Siglas / Abreviatura</label>
                        <input asp-for="Siglas" class="form-control" placeholder="Ej: DIVINCRI, CPNP" />
                        <div class="form-text small">Opcional.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">Región Policial <span class="text-danger">*</span></label>
                        <select asp-for="IdRegion" class="form-select" asp-items="ViewBag.Regiones" id="ddlRegion" required>
                            <option value="">Seleccione Región...</option>
                        </select>
                        <span asp-validation-for="IdRegion" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">División Policial</label>
                        <select asp-for="IdDivision" class="form-select" asp-items="ViewBag.Divisiones" id="ddlDivision">
                            <option value="">Seleccione División...</option>
                        </select>
                    </div>
                </div>

                <div class="bg-light p-3 rounded border mt-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="Activa" name="Activa" value="true" @(Model.Activa != false ? "checked" : "") style="cursor: pointer;" />
                        <input type="hidden" name="Activa" value="false" />
                        <label class="form-check-label fw-bold ms-2" for="Activa">Unidad Operativa (Activa)</label>
                    </div>
                    <small class="text-muted ms-5 d-block">Desactive esta opción si la unidad ha sido cerrada o fusionada, para mantener el histórico.</small>
                </div>

                <div class="row mt-5">
                    <div class="col-12 d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-police px-4">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Evento que se dispara al cambiar la Región
            $('#ddlRegion').change(function () {
                var regionId = $(this).val();
                var ddlDivision = $('#ddlDivision');

                // Limpiamos el combo de divisiones
                ddlDivision.empty();
                ddlDivision.append('<option value="">Seleccione División...</option>');

                // Si seleccionó una región válida, buscamos sus divisiones por AJAX
                if (regionId) {
                    $.getJSON('@Url.Action("ObtenerDivisiones", "Dependencias")', { idRegion: regionId }, function (data) {
                        $.each(data, function (index, item) {
                            ddlDivision.append($('<option/>', {
                                value: item.value,
                                text: item.text
                            }));
                        });
                    });
                }
            });
        });
    </script>
}
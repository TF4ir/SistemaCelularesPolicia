@model IEnumerable<SistemaCelularesPolicia.Models.Role>

@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-police fw-bold">Gestión de Roles y Permisos</h2>
            <p class="text-muted">Administre los perfiles de acceso y sus privilegios.</p>
        </div>
        <a asp-action="Upsert" class="btn btn-police shadow-sm">
            <i class="bi bi-plus-lg"></i> Nuevo Rol
        </a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Rol</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold">Descripción</th>
                            <th class="py-3 text-secondary text-uppercase small fw-bold text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.NombreRol</td>
                                <td class="text-muted">@item.Descripcion</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Upsert" asp-route-id="@item.IdRol" class="btn btn-outline-dark btn-sm">
                                        <i class="bi bi-pencil-square"></i> Editar / Permisos
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
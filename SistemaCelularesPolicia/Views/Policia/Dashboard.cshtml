@model SistemaCelularesPolicia.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Operativo";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-police mb-0">Tablero de Control</h2>
            <p class="text-muted small">Resumen operativo en tiempo real</p>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border p-2">
                <i class="bi bi-calendar-event me-1"></i> @DateTime.UtcNow.ToString("dd 'de' MMMM, yyyy")
            </span>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Total Registrados</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="mb-0 fw-bold text-dark">@Model.TotalRegistrados</h2>
                        <div class="bg-primary bg-opacity-10 p-2 rounded text-primary">
                            <i class="bi bi-phone fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Incautados (Stock)</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="mb-0 fw-bold text-danger">@Model.TotalIncautados</h2>
                        <div class="bg-danger bg-opacity-10 p-2 rounded text-danger">
                            <i class="bi bi-shield-exclamation fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Recuperados</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="mb-0 fw-bold text-success">@Model.TotalRecuperados</h2>
                        <div class="bg-success bg-opacity-10 p-2 rounded text-success">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Entregados a Dueños</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="mb-0 fw-bold text-info">@Model.TotalDevueltos</h2>
                        <div class="bg-info bg-opacity-10 p-2 rounded text-info">
                            <i class="bi bi-person-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-@(Model.EsAdmin ? "4" : "6")">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-police"><i class="bi bi-pie-chart me-2"></i> Estado de los Equipos</h6>
                </div>
                <div class="card-body" style="position: relative; height:300px;">
                    <canvas id="chartSituacion"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-@(Model.EsAdmin ? "4" : "6")">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-police"><i class="bi bi-bar-chart me-2"></i> Top 5 Marcas</h6>
                </div>
                <div class="card-body" style="position: relative; height:300px;">
                    <canvas id="chartMarcas"></canvas>
                </div>
            </div>
        </div>

        @if (Model.EsAdmin)
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold text-police"><i class="bi bi-building me-2"></i> Top 5 Comisarías</h6>
                    </div>
                    <div class="card-body" style="position: relative; height:300px;">
                        <canvas id="chartComisarias"></canvas>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-police"><i class="bi bi-clock-history me-2"></i> Actividad Reciente</h6>
            <a asp-action="VerRegistros" class="btn btn-sm btn-outline-primary">Ver todos</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Dispositivo</th>
                        <th>IMEI</th>
                        <th>Situación</th>
                        <th>Fecha</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UltimosRegistros != null && Model.UltimosRegistros.Any())
                    {
                        @foreach (var item in Model.UltimosRegistros)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.Marca @item.Modelo</td>
                                <td class="small font-monospace">@item.Imei</td>
                                <td>
                                    @{
                                        var situacion = item.Situacion?.ToUpper() ?? "";
                                        var badgeClass = situacion switch
                                        {
                                            "INCAUTADO" => "bg-danger",
                                            "RECUPERADO" => "bg-success",
                                            "DEVUELTO" => "bg-primary",
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill">@item.Situacion</span>
                                </td>
                                <td class="small text-muted">@item.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Corregir" asp-route-id="@item.IdCelular" class="btn btn-sm btn-light text-primary" title="Ver detalle / Corregir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay registros recientes disponibles.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
        // 1. Gráfico de Situación (Dona)
        const ctxSituacion = document.getElementById('chartSituacion');
        if (ctxSituacion) {
        new Chart(ctxSituacion.getContext('2d'), {
        type: 'doughnut',
        data: {
        labels: @Html.Raw(Json.Serialize(Model.LabelsSituacion)),
        datasets: [{
        data: @Html.Raw(Json.Serialize(Model.DataSituacion)),
        backgroundColor: ['#dc3545', '#198754', '#0dcaf0', '#ffc107', '#6c757d'],
        borderWidth: 0
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
        }
        });
        }

        // 2. Gráfico de Marcas (Barras Verticales)
        const ctxMarcas = document.getElementById('chartMarcas');
        if (ctxMarcas) {
        new Chart(ctxMarcas.getContext('2d'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(Json.Serialize(Model.LabelsMarcas)),
        datasets: [{
        label: 'Equipos',
        data: @Html.Raw(Json.Serialize(Model.DataMarcas)),
        backgroundColor: '#1e3a8a',
        borderRadius: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { display: false } }
        }
        });
        }

        // 3. Gráfico de Comisarías (Barras Horizontales - Solo Admin)
        @if (Model.EsAdmin)
        {
            <text>
                const ctxComisarias = document.getElementById('chartComisarias');
                if (ctxComisarias) {
                new Chart(ctxComisarias.getContext('2d'), {
                type: 'bar', // Tipo barra
                data: {
                labels: @Html.Raw(Json.Serialize(Model.LabelsComisarias)),
                datasets: [{
                label: 'Registros',
                data: @Html.Raw(Json.Serialize(Model.DataComisarias)),
                backgroundColor: '#198754', // Verde Institucional
                borderRadius: 4
                }]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y', // ESTO LO HACE HORIZONTAL
                scales: { x: { beginAtZero: true } },
                plugins: { legend: { display: false } }
                }
                });
                }
            </text>
        }
        });
    </script>
}
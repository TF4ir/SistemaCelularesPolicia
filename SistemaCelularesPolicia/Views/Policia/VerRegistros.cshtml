@model SistemaCelularesPolicia.Models.ViewModels.PaginacionViewModel

@{
    ViewData["Title"] = "Registros Policiales";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-police mb-0">Registros de Incautaciones</h2>
            <p class="text-muted small">Gestión de dispositivos registrados</p>
        </div>
        <a asp-action="Registrar" class="btn btn-police">
            <i class="bi bi-plus-lg me-2"></i> Nuevo Registro
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3 bg-light rounded">
            <form asp-action="VerRegistros" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="busqueda" value="@Model.BusquedaActual"
                               class="form-control border-start-0 ps-0"
                               placeholder="Buscar por IMEI, Marca o Modelo...">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.BusquedaActual))
                {
                    <div class="col-auto">
                        <a asp-action="VerRegistros" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i> Limpiar filtro
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Dispositivo</th>
                        <th>IMEI</th>
                        <th>Situación</th>
                        <th>Fecha</th>
                        <th>Fiscalía</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Celulares)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark">@item.Marca</span>
                                    <span class="small text-muted">@item.Modelo</span>
                                </div>
                            </td>
                            <td>
                                <span class="font-monospace bg-light border rounded px-2 py-1 small">
                                    @item.Imei
                                </span>
                            </td>
                            <td>
                                @{
                                    var situacion = item.Situacion?.ToUpper() ?? "";
                                    var badgeClass = situacion switch
                                    {
                                        "INCAUTADO" => "bg-danger",
                                        "RECUPERADO" => "bg-success",
                                        "DEVUELTO" => "bg-primary",
                                        "CUSTODIA" => "bg-warning text-dark",
                                        "BAJA" => "bg-dark text-white",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill fw-normal">@item.Situacion</span>
                            </td>
                            <td class="small text-muted">
                                @item.FechaRegistro?.ToString("dd/MM/yyyy")
                            </td>
                            <td class="small">
                                <i class="bi bi-building me-1 text-muted"></i>
                                @(item.IdFiscaliaNavigation?.NombreFiscalia ?? "N/A")
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Corregir" asp-route-id="@item.IdCelular" class="btn btn-sm btn-outline-secondary" title="Corregir"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="CambiarEstado" asp-route-id="@item.IdCelular" class="btn btn-sm btn-outline-primary" title="Estado"><i class="bi bi-arrow-repeat"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Celulares.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search text-muted fs-1 opacity-50"></i>
                    <p class="text-muted mt-2">No se encontraron resultados para su búsqueda.</p>
                </div>
            }
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center border-top">
                <span class="text-muted small">
                    Página <strong>@Model.PaginaActual</strong> de <strong>@Model.TotalPaginas</strong>
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link border-0 text-secondary"
                               asp-action="VerRegistros"
                               asp-route-pagina="@(Model.PaginaActual - 1)"
                               asp-route-busqueda="@Model.BusquedaActual">
                                <i class="bi bi-chevron-left me-1"></i> Anterior
                            </a>
                        </li>

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link border-0 text-secondary"
                               asp-action="VerRegistros"
                               asp-route-pagina="@(Model.PaginaActual + 1)"
                               asp-route-busqueda="@Model.BusquedaActual">
                                Siguiente <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
@model SistemaCelularesPolicia.Models.ViewModels.PaginacionViewModel

@{
    ViewData["Title"] = "Registros Policiales";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-police mb-0">Registros de Incautaciones</h2>
            <p class="text-muted small">Gestión de dispositivos registrados</p>
        </div>
        <a asp-action="Registrar" class="btn btn-police">
            <i class="bi bi-plus-lg me-2"></i> Nuevo Registro
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3 bg-light rounded">
            <form asp-action="VerRegistros" method="get" id="formFiltros">
                
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="busqueda" value="@Model.BusquedaActual" class="form-control border-start-0 ps-0" placeholder="Buscar por IMEI, Marca o Modelo...">
                        </div>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                        <button class="btn btn-outline-secondary ms-1" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosAvanzados">
                            <i class="bi bi-funnel"></i> Filtros
                        </button>
                        
                        @if (!string.IsNullOrEmpty(Model.BusquedaActual) || Model.FechaInicio.HasValue || Model.SituacionesSeleccionadas.Any() || Model.IdDependenciaFiltro.HasValue)
                        {
                            <a asp-action="VerRegistros" class="btn btn-outline-danger ms-1"><i class="bi bi-x-lg"></i> Limpiar</a>
                        }
                    </div>
                </div>

                <div class="collapse @(Model.FechaInicio.HasValue || Model.SituacionesSeleccionadas.Any() || (ViewBag.EsAdmin && Model.IdDependenciaFiltro.HasValue) ? "show" : "")" id="filtrosAvanzados">
                    <div class="card card-body bg-white border shadow-sm mb-2">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted">Desde (Incautación)</label>
                                <input type="date" name="fechaInicio" class="form-control form-control-sm" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted">Hasta (Incautación)</label>
                                <input type="date" name="fechaFin" class="form-control form-control-sm" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                            </div>
                            
                            @if (ViewBag.EsAdmin)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Filtrar por Dependencia PNP</label>
                                    <select name="idDependenciaFiltro" class="form-select form-select-sm" asp-items="ViewBag.Dependencias">
                                        <option value="">-- Ver todas las dependencias --</option>
                                    </select>
                                </div>
                            }

                            <div class="col-12 mt-3 border-top pt-3">
                                <label class="form-label small fw-bold text-muted d-block mb-2">Estado del Equipo</label>
                                @{
                                    var opciones = new[] { "INCAUTADO", "RECUPERADO", "DEVUELTO"};
                                }
                                
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var opc in opciones)
                                    {
                                        <div class="form-check form-check-inline m-0">
                                            <input class="form-check-input" type="checkbox" name="situaciones" value="@opc" id="chk_@opc" @(Model.SituacionesSeleccionadas.Contains(opc) ? "checked" : "")>
                                            <label class="form-check-label small" for="chk_@opc">@opc</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-sm btn-police"><i class="bi bi-check2-circle me-1"></i> Aplicar Filtros</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Dispositivo</th>
                        <th>IMEI</th>
                        <th>Situación</th>
                        <th>Fecha</th>
                        <th>Fiscalía</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Celulares)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark">@item.Marca</span>
                                    <span class="small text-muted">@item.Modelo</span>
                                </div>
                            </td>
                            <td>
                                <span class="font-monospace bg-light border rounded px-2 py-1 small">
                                    @item.Imei
                                </span>
                            </td>
                            <td>
                                @{
                                    var situacion = item.Situacion?.ToUpper() ?? "";
                                    var badgeClass = situacion switch
                                    {
                                        "INCAUTADO" => "bg-danger",
                                        "RECUPERADO" => "bg-success",
                                        "DEVUELTO" => "bg-primary",
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill fw-normal">@item.Situacion</span>
                            </td>
                            <td class="small text-muted">
                                @item.FechaRegistro?.ToString("dd/MM/yyyy")
                            </td>
                            <td class="small">
                                <i class="bi bi-building me-1 text-muted"></i>
                                @(item.IdFiscaliaNavigation?.NombreFiscalia ?? "N/A")
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Corregir" asp-route-id="@item.IdCelular" class="btn btn-sm btn-outline-secondary" title="Corregir"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="CambiarEstado" asp-route-id="@item.IdCelular" class="btn btn-sm btn-outline-primary" title="Estado"><i class="bi bi-arrow-repeat"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Celulares.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search text-muted fs-1 opacity-50"></i>
                    <p class="text-muted mt-2">No se encontraron resultados para los filtros aplicados.</p>
                </div>
            }
        </div>

        @if (Model.TotalRegistros > 0)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center border-top">
                <span class="text-police fw-bold small">
                    <i class="bi bi-phone me-1"></i> Cantidad: @Model.TotalRegistros
                </span>

                @if (Model.TotalPaginas > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <button type="button" class="page-link border-0 text-secondary" onclick="irAPagina(@(Model.PaginaActual - 1))">
                                    <i class="bi bi-chevron-left me-1"></i> Anterior
                                </button>
                            </li>

                            <li class="page-item disabled d-none d-md-block">
                                <span class="page-link border-0 bg-transparent text-muted">
                                    Página @Model.PaginaActual de @Model.TotalPaginas
                                </span>
                            </li>

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <button type="button" class="page-link border-0 text-secondary" onclick="irAPagina(@(Model.PaginaActual + 1))">
                                    Siguiente <i class="bi bi-chevron-right ms-1"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Función para que la paginación no borre los filtros seleccionados
        function irAPagina(numPagina) {
            // Creamos un campo oculto con el número de página al que vamos
            $('<input>').attr({
                type: 'hidden',
                name: 'pagina',
                value: numPagina
            }).appendTo('#formFiltros');
            
            // Enviamos todo el formulario con los checkboxes y fechas actuales
            $('#formFiltros').submit();
        }
    </script>
}
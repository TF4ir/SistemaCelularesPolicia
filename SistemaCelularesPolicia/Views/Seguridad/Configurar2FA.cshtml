@{
    ViewData["Title"] = "Configurar 2FA";
    Layout = null; // Usamos pantalla completa limpia
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Configurar Seguridad</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card p-4">
                    <div class="card-body text-center">

                        <div class="mb-4">
                            <i class="bi bi-qr-code-scan text-police" style="font-size: 3rem;"></i>
                            <h3 class="fw-bold mt-3 text-dark">Protege tu Cuenta</h3>
                            <p class="text-muted small">
                                Escanea este código QR con la aplicación <strong>Google Authenticator</strong> en tu celular.
                            </p>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border d-inline-block">
                            <img src="@ViewBag.QrCodeUrl" alt="Código QR" class="img-fluid" style="max-width: 200px;" />
                        </div>

                        <div class="mb-4">
                            <p class="small text-muted mb-1">¿No puedes escanearlo?</p>
                            <p class="font-monospace fw-bold text-dark bg-light p-2 rounded small">
                                @ViewBag.ManualCode
                            </p>
                        </div>

                        <hr class="my-4" />

                        <p class="text-start fw-bold small text-secondary mb-2">Ingresa el código de 6 dígitos que aparece en la App:</p>

                        <form asp-controller="Seguridad" asp-action="ConfirmarActivacion" method="post">

                            <div class="input-with-icon mb-3">
                                <i class="bi bi-shield-lock"></i>
                                <input type="text" name="codigoIngresado"
                                       class="form-control text-center fw-bold fs-5"
                                       placeholder="000000"
                                       maxlength="6"
                                       pattern="\d*"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       required>
                            </div>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger py-2 small mb-3">
                                    <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
                                </div>
                            }

                            <button type="submit" class="btn btn-police w-100">
                                Activar Seguridad
                            </button>
                        </form>

                        <div class="mt-3">
                            <a asp-controller="Account" asp-action="Salir" class="text-muted small text-decoration-none">
                                Cancelar y Salir
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
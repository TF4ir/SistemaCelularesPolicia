@{
    ViewData["Title"] = "Bienvenido";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema PNP - Recuperación de Equipos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container" style="max-width: 1000px;">
        <div class="text-center text-white mb-5">
            <div class="mb-3">
                <i class="bi bi-shield-check" style="font-size: 4rem;"></i>
            </div>
            <h1 class="fw-bold display-5">Sistema de Información y Consulta de Celulares Incautados y Recuperados</h1>
            <h2 class="fw-bold display-5">SICCIR</h2>
            <p class="lead text-white-50">Policía Nacional del Perú - Junin</p>
        </div>

        <div class="row g-4 justify-content-center">

            <div class="col-md-6 col-lg-5">
                <a asp-controller="Account" asp-action="LoginPolicia" class="text-decoration-none">
                    <div class="card h-100 hover-card border-0 rounded-4 shadow-lg">
                        <div class="card-body p-5 text-center">

                            <div class="icon-circle-box" style="background-color: #dbeafe; color: var(--police-primary);">
                                <i class="bi bi-shield-fill"></i>
                            </div>

                            <h3 class="text-police fw-bold mb-3">Personal Policial</h3>
                            <p class="text-muted mb-4">
                                Acceso restringido para el registro de operativos e incautaciones.
                            </p>

                            <span class="btn btn-police w-100 py-3 rounded-3 fw-bold">
                                INGRESAR <i class="bi bi-arrow-right ms-2"></i>
                            </span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-5">
                <a asp-controller="Account" asp-action="LoginPublico" class="text-decoration-none">
                    <div class="card h-100 hover-card border-0 rounded-4 shadow-lg">
                        <div class="card-body p-5 text-center">

                            <div class="icon-circle-box" style="background-color: #dcfce7; color: var(--public-primary);">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <h3 class="text-public fw-bold mb-3">Público en General</h3>
                            <p class="text-muted mb-4">
                                Consulte si su equipo ha sido recuperado. Requiere DNI o Correo.
                            </p>

                            <span class="btn btn-public w-100 py-3 rounded-3 fw-bold">
                                CONSULTAR <i class="bi bi-search ms-2"></i>
                            </span>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</body>
</html>
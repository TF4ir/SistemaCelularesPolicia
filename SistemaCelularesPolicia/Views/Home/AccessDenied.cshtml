@{
    ViewData["Title"] = "Acceso Denegado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema PNP - Recuperación de Equipos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<div class="container mt-5 text-center">
    <div class="card border-danger mb-3 mx-auto" style="max-width: 600px;">
        <div class="card-header bg-danger text-white">
            <h3><i class="bi bi-shield-x"></i> Acceso Restringido</h3>
        </div>
        <div class="card-body">
            <h5 class="card-title text-danger">No tienes permisos para ver esta página</h5>
            <p class="card-text">
                Tu rol actual no tiene los privilegios necesarios para realizar esta acción.
                Si crees que es un error, contacta al administrador del sistema.
            </p>
            <a asp-controller="Policia" asp-action="Registrar" class="btn btn-outline-secondary">
                Volver al Inicio
            </a>
            <a asp-controller="Account" asp-action="Salir" class="btn btn-danger">
                Cerrar Sesión
            </a>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Acceso Restringido";
    Layout = "_LayoutSidebar";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 75vh;">

    <div class="icon-circle-box bg-danger bg-opacity-10 text-danger mb-3">
        <i class="bi bi-shield-lock-fill" style="font-size: 2.5rem;"></i>
    </div>

    <h2 class="text-danger fw-bold mb-2">Acceso Denegado</h2>
    <p class="text-muted mb-4" style="font-size: 1rem;">No tiene los permisos necesarios para acceder a esta sección.</p>

    <div class="card border-0 border-start border-danger border-4 shadow-sm text-start" style="max-width: 620px; width: 100%;">
        <div class="card-body p-4 bg-light bg-opacity-50">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> AVISO DEL SISTEMA SICIR:
            </h6>
            <p class="mb-3 text-muted lh-base">
                Usted se ha registrado en el sistema <strong>SICCIR</strong>. Para hacer uso de los módulos operativos o administrativos, debe solicitar el rol de acceso adjuntando el oficio y el acta respectiva.
            </p>
            <hr class="my-3 text-secondary">
            <p class="mb-1 text-muted small">
                Remita la documentación al correo electrónico oficial:
            </p>
            <a href="mailto:rpjunin.utic@policia.gob.pe" class="fw-bold text-police text-decoration-none d-inline-flex align-items-center mt-1" style="font-size: 1.05rem;">
                <i class="bi bi-envelope-at-fill me-2"></i> rpjunin.utic@policia.gob.pe
            </a>
        </div>
    </div>

    <div class="mt-5">
        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Volver Atrás
        </a>
    </div>

</div>
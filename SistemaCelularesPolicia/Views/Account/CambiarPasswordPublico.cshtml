@model SistemaCelularesPolicia.Models.ViewModels.RestablecerPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Nueva Contraseña</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card border-0 shadow-lg rounded-4 my-5">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <div class="icon-circle-box bg-success-subtle text-public mb-3 d-inline-flex p-3 rounded-circle">
                                <i class="bi bi-shield-lock fs-1"></i>
                            </div>
                            <h3 class="fw-bold text-public">Nueva Contraseña</h3>
                            <p class="text-muted small">Revise su correo: <strong>@Model.Email</strong></p>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small shadow-sm border-0 mb-3"></div>

                        <form asp-action="CambiarPasswordPublico" method="post">
                            <input type="hidden" asp-for="Email" />

                            <div class="mb-3">
                                <label asp-for="Codigo" class="form-label text-secondary fw-bold small">Código de Verificación</label>
                                <div class="input-with-icon position-relative">
                                    <i class="bi bi-upc-scan position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                    <input asp-for="Codigo" class="form-control ps-5 text-center tracking-widest fw-bold fs-5" placeholder="000000" maxlength="6" style="letter-spacing: 5px;" />
                                </div>
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NuevaPassword" class="form-label text-secondary fw-bold small">Nueva Contraseña</label>
                                <div class="input-with-icon position-relative">
                                    <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>

                                    <input asp-for="NuevaPassword" id="txtPass" type="password" class="form-control ps-5 pe-5" placeholder="••••••••" />

                                    <button type="button"
                                            class="btn border-0 bg-transparent position-absolute top-50 end-0 translate-middle-y me-3 text-muted toggle-password"
                                            data-target="#txtPass"
                                            style="z-index: 10; cursor: pointer;">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NuevaPassword" class="text-danger small"></span>

                                <div class="progress mt-2" style="height: 4px;">
                                    <div id="pass-strength-bar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small id="pass-strength-text" class="text-muted d-block text-end mt-1" style="font-size: 0.7rem;">Seguridad</small>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmarPassword" class="form-label text-secondary fw-bold small">Confirmar Contraseña</label>
                                <div class="input-with-icon position-relative">
                                    <i class="bi bi-lock-fill position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>

                                    <input asp-for="ConfirmarPassword" id="txtConfirm" type="password" class="form-control ps-5 pe-5" placeholder="••••••••" />

                                    <button type="button"
                                            class="btn border-0 bg-transparent position-absolute top-50 end-0 translate-middle-y me-3 text-muted toggle-password"
                                            data-target="#txtConfirm"
                                            style="z-index: 10; cursor: pointer;">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-public w-100 py-3 fw-bold shadow-sm">
                                Cambiar Contraseña
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // 1. Mostrar/Ocultar Contraseña (Funciona para ambos campos)
            $('.toggle-password').click(function () {
                var inputId = $(this).data('target');
                var input = $(inputId);
                var icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });

            // 2. Barra de Seguridad
            $('#txtPass').on('keyup', function () {
                var pass = $(this).val();
                var score = 0;

                // Lógica de puntuación
                if (pass.length > 5) score++;
                if (/[A-Z]/.test(pass)) score++;
                if (/[0-9]/.test(pass)) score++;
                if (/[^A-Za-z0-9]/.test(pass)) score++;

                var bar = $('#pass-strength-bar');
                var text = $('#pass-strength-text');
                var width = 0;
                var color = 'bg-danger';
                var msg = 'Muy débil';

                switch (score) {
                    case 1: width = 25; color = 'bg-danger'; msg = 'Débil'; break;
                    case 2: width = 50; color = 'bg-warning'; msg = 'Media'; break;
                    case 3: width = 75; color = 'bg-info'; msg = 'Buena'; break;
                    case 4: width = 100; color = 'bg-success'; msg = 'Excelente'; break;
                }

                if (pass.length === 0) { width = 0; msg = 'Seguridad'; }

                // Aplicar estilos visuales
                bar.css('width', width + '%');
                bar.removeClass('bg-danger bg-warning bg-info bg-success').addClass(color);
                text.text(msg);

                text.removeClass('text-danger text-warning text-info text-success text-muted');
                if (width === 0) text.addClass('text-muted');
                else if (score <= 1) text.addClass('text-danger');
                else if (score === 2) text.addClass('text-warning');
                else if (score === 3) text.addClass('text-info');
                else text.addClass('text-success');
            });
        });
    </script>
</body>
</html>
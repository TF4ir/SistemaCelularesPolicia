@{
    ViewData["Title"] = "Verificación 2FA";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Verificación 2FA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <div class="card p-4">
                    <div class="card-body">

                        <div class="mb-4">
                            <a asp-action="LoginPolicia" class="link-back">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>

                        <div class="text-center mb-4">
                            <div class="icon-circle-box bg-light text-police mb-3" style="width: 70px; height: 70px; font-size: 1.8rem;">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <h4 class="fw-bold text-dark">Verificación de Dos Pasos</h4>
                            <p class="text-muted small">
                                Por seguridad, ingresa el código generado por tu aplicación Google Authenticator.
                            </p>
                        </div>

                        <form asp-action="Verificar2FA" method="post">

                            <div class="mb-4">
                                <label class="form-label small fw-bold text-secondary">Código de 6 dígitos</label>
                                <div class="input-with-icon">
                                    <i class="bi bi-key"></i>
                                    <input type="text"
                                           name="codigo2fa"
                                           class="form-control fs-5 text-center fw-bold"
                                           placeholder="000 000"
                                           maxlength="6"
                                           pattern="\d*"
                                           inputmode="numeric"
                                           autocomplete="one-time-code"
                                           required
                                           autofocus>
                                </div>
                            </div>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger py-2 small text-center mb-3">
                                    <i class="bi bi-x-circle me-1"></i> @ViewBag.Error
                                </div>
                            }

                            <button type="submit" class="btn btn-police w-100 py-3 mb-3">
                                Verificar
                            </button>

                            <div class="text-center">
                                <a href="#" class="text-muted small text-decoration-none">
                                    ¿Perdiste tu dispositivo?
                                </a>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
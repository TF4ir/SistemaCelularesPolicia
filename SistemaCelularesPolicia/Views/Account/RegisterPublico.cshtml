@model SistemaCelularesPolicia.Models.ViewModels.RegisterPublicoViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registro Público</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card border-0 shadow-lg rounded-4 my-5">
                    <div class="card-body p-5">

                        <a asp-action="LoginPublico" asp-controller="Account" class="link-back mb-4 text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>

                        <div class="text-center mb-5">
                            <div class="icon-circle-box bg-success-subtle text-public mb-3 d-inline-flex p-3 rounded-circle">
                                <i class="bi bi-person fs-1"></i>
                            </div>
                            <h3 class="fw-bold text-public">Registro de Usuario Público</h3>
                            <p class="text-muted">Complete sus datos para crear una cuenta</p>
                        </div>

                        <form asp-action="RegisterPublic" method="post">

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="Dni" class="form-label text-secondary fw-bold small">DNI <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-card-heading position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Dni" class="form-control ps-5" placeholder="8 dígitos" maxlength="8" />
                                    </div>
                                    <span asp-validation-for="Dni" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Nombres" class="form-label text-secondary fw-bold small">Nombres <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Nombres" class="form-control ps-5" placeholder="Juan Carlos" />
                                    </div>
                                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Apellidos" class="form-label text-secondary fw-bold small">Apellidos <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Apellidos" class="form-control ps-5" placeholder="García Pérez" />
                                    </div>
                                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Email" class="form-label text-secondary fw-bold small">Correo Electrónico <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-envelope position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Email" type="email" class="form-control ps-5" placeholder="correo@ejemplo.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Telefono" class="form-label text-secondary fw-bold small">Teléfono <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-phone position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Telefono" class="form-control ps-5" placeholder="987654321" />
                                    </div>
                                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="FechaNacimiento" class="form-label text-secondary fw-bold small">Fecha de Nacimiento <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-calendar position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="FechaNacimiento" type="date" class="form-control ps-5" />
                                    </div>
                                    <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Direccion" class="form-label text-secondary fw-bold small">Dirección <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-geo-alt position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Direccion" class="form-control ps-5" placeholder="Av. Principal 123, Lima" />
                                    </div>
                                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label text-secondary fw-bold small">Contraseña <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Password" id="txtPass" class="form-control ps-5 pe-5" placeholder="••••••••" />

                                        <button type="button"
                                                class="btn border-0 bg-transparent position-absolute top-50 end-0 translate-middle-y me-4 text-muted toggle-password"
                                                data-target="#txtPass"
                                                style="z-index: 10; cursor: pointer;">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>

                                    <div class="progress mt-2" style="height: 4px;">
                                        <div id="pass-strength-bar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                    </div>
                                    <small id="pass-strength-text" class="text-muted d-block text-end mt-1" style="font-size: 0.7rem;">Seguridad</small>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label text-secondary fw-bold small">Confirmar Contraseña <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-lock-fill position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="ConfirmPassword" id="txtConfirmPass" class="form-control ps-5 pe-5" placeholder="••••••••" />

                                        <button type="button"
                                                class="btn border-0 bg-transparent position-absolute top-50 end-0 translate-middle-y me-4 text-muted toggle-password"
                                                data-target="#txtConfirmPass"
                                                style="z-index: 10; cursor: pointer;">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-4 pt-2">
                                <button type="submit" class="btn btn-public w-100 py-3 fw-bold shadow-sm">
                                    <i class="bi bi-person-add me-2"></i> Registrarse
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // 1. Mostrar/Ocultar Contraseña
            $('.toggle-password').click(function () {
                var inputId = $(this).data('target');
                var input = $(inputId);
                var icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });

            // 2. Barra de Seguridad
            $('#txtPass').on('keyup', function () {
                var pass = $(this).val();
                var score = 0;

                if (pass.length > 5) score++;
                if (/[A-Z]/.test(pass)) score++;
                if (/[0-9]/.test(pass)) score++;
                if (/[^A-Za-z0-9]/.test(pass)) score++;

                var bar = $('#pass-strength-bar');
                var text = $('#pass-strength-text');
                var width = 0;
                var color = 'bg-danger';
                var msg = 'Muy débil';

                switch (score) {
                    case 1: width = 25; color = 'bg-danger'; msg = 'Débil'; break;
                    case 2: width = 50; color = 'bg-warning'; msg = 'Media'; break;
                    case 3: width = 75; color = 'bg-info'; msg = 'Buena'; break;
                    case 4: width = 100; color = 'bg-success'; msg = 'Excelente'; break;
                }

                if (pass.length === 0) { width = 0; msg = 'Seguridad'; }

                bar.css('width', width + '%');
                bar.removeClass('bg-danger bg-warning bg-info bg-success').addClass(color);
                text.text(msg);

                text.removeClass('text-danger text-warning text-info text-success text-muted');
                if (width === 0) text.addClass('text-muted');
                else if (score <= 1) text.addClass('text-danger');
                else if (score === 2) text.addClass('text-warning');
                else if (score === 3) text.addClass('text-info');
                else text.addClass('text-success');
            });
        });
    </script>
</body>
</html>
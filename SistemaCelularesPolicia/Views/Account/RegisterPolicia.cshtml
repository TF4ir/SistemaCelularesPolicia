@model SistemaCelularesPolicia.Models.ViewModels.RegisterPoliciaViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registro de Personal Policial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            .toggle-password {
                cursor: pointer;
                z-index: 10;
            }
    </style>
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card border-0 shadow-lg rounded-4 my-5">
                    <div class="card-body p-5">

                        <a asp-action="LoginPolicia" asp-controller="Account" class="link-back mb-4 text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>

                        <div class="text-center mb-5">
                            <div class="icon-circle-box bg-success-subtle text-police mb-3 d-inline-flex p-3 rounded-circle">
                                <i class="bi bi-shield-shaded fs-1"></i>
                            </div>
                            <h3 class="fw-bold text-police">Registro de Personal Policial</h3>
                            <p class="text-muted">Complete sus datos institucionales</p>
                        </div>

                        <form asp-action="RegisterPolice" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="CodigoPolicial" class="form-label text-secondary fw-bold small">Código Policial <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-shield position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="CodigoPolicial" class="form-control ps-5" placeholder="8 dígitos" maxlength="8" />
                                    </div>
                                    <span asp-validation-for="CodigoPolicial" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Dni" class="form-label text-secondary fw-bold small">DNI <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-card-heading position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Dni" class="form-control ps-5" placeholder="8 dígitos" maxlength="8" />
                                    </div>
                                    <span asp-validation-for="Dni" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Nombres" class="form-label text-secondary fw-bold small">Nombres <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Nombres" class="form-control ps-5" placeholder="Juan Carlos" />
                                    </div>
                                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Apellidos" class="form-label text-secondary fw-bold small">Apellidos <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Apellidos" class="form-control ps-5" placeholder="García Pérez" />
                                    </div>
                                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4 mb-2">
                                    <h6 class="text-police border-bottom pb-2 fw-bold"><i class="bi bi-building me-2"></i>Asignación</h6>
                                </div>

                                <div class="col-md-12">
                                    <label asp-for="RangoGrado" class="form-label text-secondary fw-bold small">Rango/Grado <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-award position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <select asp-for="RangoGrado" class="form-select ps-5">
                                            <option value="">Seleccione...</option>
                                            <option value="SUBOFICIAL DE TERCERA">SUBOFICIAL DE TERCERA</option>
                                            <option value="SUBOFICIAL DE SEGUNDA">SUBOFICIAL DE SEGUNDA</option>
                                            <option value="SUBOFICIAL DE PRIMERA">SUBOFICIAL DE PRIMERA</option>
                                            <option value="SUBOFICIAL TECNICO DE TERCERA">SUBOFICIAL TECNICO DE TERCERA</option>
                                            <option value="SUBOFICIAL TECNICO DE SEGUNDA">SUBOFICIAL TECNICO DE SEGUNDA</option>
                                            <option value="SUBOFICIAL TECNICO DE PRIMERA">SUBOFICIAL TECNICO DE PRIMERA</option>
                                            <option value="SUBOFICIAL BRIGADIER">SUBOFICIAL BRIGADIER</option>
                                            <option value="SUBOFICIAL SUPERIOR">SUBOFICIAL SUPERIOR</option>
                                            <option value="ALFEREZ">ALFEREZ</option>
                                            <option value="TENIENTE">TENIENTE</option>
                                            <option value="CAPITAN">CAPITAN</option>
                                            <option value="MAYOR">MAYOR</option>
                                            <option value="COMANDANTE">COMANDANTE</option>
                                            <option value="CORONEL">CORONEL</option>
                                            <option value="GENERAL">GENERAL</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="RangoGrado" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label text-police fw-bold small">1. Filtro Provincia</label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-geo-alt position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <select id="ddlProvincia" class="form-select ps-5 border-success">
                                            <option value="">Seleccione Provincia...</option>
                                            @if (ViewBag.Provincias != null)
                                            {
                                                foreach (var prov in ViewBag.Provincias)
                                                {
                                                    <option value="@prov">@prov</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="UnidadDependencia" class="form-label text-police fw-bold small">2. Unidad Policial <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-building position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <select asp-for="UnidadDependencia" id="ddlUnidad" class="form-select ps-5" required disabled>
                                            <option value="">-- Primero elija Provincia --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="UnidadDependencia" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="EmailInstitucional" class="form-label text-secondary fw-bold small">Email Institucional <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-envelope position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="EmailInstitucional" type="email" class="form-control ps-5" placeholder="usuario@policia.gob.pe" />
                                    </div>
                                    <span asp-validation-for="EmailInstitucional" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="TelefonoContacto" class="form-label text-secondary fw-bold small">Teléfono <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-phone position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="TelefonoContacto" class="form-control ps-5" placeholder="987654321" />
                                    </div>
                                    <span asp-validation-for="TelefonoContacto" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4 mb-2">
                                    <h6 class="text-police border-bottom pb-2 fw-bold"><i class="bi bi-lock me-2"></i>Seguridad de Acceso</h6>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label text-secondary fw-bold small">Contraseña <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="Password" id="txtPass" class="form-control ps-5 pe-5" placeholder="••••••••" />
                                        <button type="button" class="btn border-0 bg-transparent position-absolute top-50 end-0 translate-middle-y me-4 text-muted toggle-password" data-target="#txtPass">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>

                                    <div class="progress mt-2" style="height: 4px;">
                                        <div id="pass-strength-bar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                    </div>
                                    <small id="pass-strength-text" class="text-muted d-block text-end mt-1" style="font-size: 0.7rem;">Seguridad</small>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label text-secondary fw-bold small">Confirmar Contraseña <span class="text-danger">*</span></label>
                                    <div class="input-with-icon position-relative">
                                        <i class="bi bi-check-circle position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                        <input asp-for="ConfirmPassword" id="txtConfirmPass" class="form-control ps-5 pe-5" placeholder="••••••••" />
                                        <button type="button" class="btn border-0 bg-transparent position-absolute top-50 end-0 translate-middle-y me-4 text-muted toggle-password" data-target="#txtConfirmPass">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-5">
                                <button type="submit" class="btn btn-police w-100 py-3 fw-bold shadow-sm">
                                    <i class="bi bi-person-plus-fill me-2"></i> Registrar Oficial
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
            $(document).ready(function () {

                // --- 1. LÓGICA DE UNIDADES EN CASCADA (AJAX) ---
                $("#ddlProvincia").change(function () {
                    var provinciaSeleccionada = $(this).val();
                    var $ddlUnidad = $("#ddlUnidad");

                    $ddlUnidad.empty();

                    if (provinciaSeleccionada) {
                        $ddlUnidad.append('<option value="">Cargando unidades...</option>');
                        $ddlUnidad.prop("disabled", true);

                        $.ajax({
                            url: '/Account/ObtenerUnidadesPorProvincia',
                            type: 'GET',
                            data: { provincia: provinciaSeleccionada },
                            success: function (data) {
                                $ddlUnidad.empty();
                                $ddlUnidad.append('<option value="">-- Seleccione su Unidad --</option>');
                                $.each(data, function (i, item) {
                                    $ddlUnidad.append($('<option>', {
                                        value: item.valor,
                                        text: item.texto
                                    }));
                                });
                                $ddlUnidad.prop("disabled", false);
                            },
                            error: function () {
                                $ddlUnidad.empty();
                                $ddlUnidad.append('<option value="">Error al cargar</option>');
                                alert('No se pudo conectar con el servidor.');
                            }
                        });
                    } else {
                        $ddlUnidad.append('<option value="">-- Primero elija Provincia --</option>');
                        $ddlUnidad.prop("disabled", true);
                    }
                });

                // --- 2. MOSTRAR/OCULTAR CONTRASEÑA ---
                $('.toggle-password').click(function () {
                    var inputId = $(this).data('target');
                    var input = $(inputId);
                    var icon = $(this).find('i');

                    if (input.attr('type') === 'password') {
                        input.attr('type', 'text');
                        icon.removeClass('bi-eye-slash').addClass('bi-eye');
                    } else {
                        input.attr('type', 'password');
                        icon.removeClass('bi-eye').addClass('bi-eye-slash');
                    }
                });

                // --- 3. BARRA DE SEGURIDAD (STRENGTH METER) ---
                $('#txtPass').on('keyup', function () {
                    var pass = $(this).val();
                    var score = 0;
                
                    // Criterios
                    if (pass.length > 5) score++;
                    if (/[A-Z]/.test(pass)) score++;
                    if (/[0-9]/.test(pass)) score++;
                    if (/[^A-Za-z0-9]/.test(pass)) score++; // Símbolo

                    var bar = $('#pass-strength-bar');
                    var text = $('#pass-strength-text');
                    var width = 0;
                    var color = 'bg-danger';
                    var msg = 'Muy débil';

                    switch (score) {
                        case 1: width = 25; color = 'bg-danger'; msg = 'Débil'; break;
                        case 2: width = 50; color = 'bg-warning'; msg = 'Media'; break;
                        case 3: width = 75; color = 'bg-info'; msg = 'Buena'; break;
                        case 4: width = 100; color = 'bg-success'; msg = 'Excelente'; break;
                    }

                    if (pass.length === 0) {
                        width = 0;
                        msg = 'Seguridad';
                    }

                    bar.css('width', width + '%');
                    bar.removeClass('bg-danger bg-warning bg-info bg-success').addClass(color);
                    text.text(msg);
                
                    // Color del texto
                    text.removeClass('text-danger text-warning text-info text-success text-muted');
                    if (width === 0) text.addClass('text-muted');
                    else if (score <= 1) text.addClass('text-danger');
                    else if (score === 2) text.addClass('text-warning');
                    else if (score === 3) text.addClass('text-info');
                    else text.addClass('text-success');
                });
            });
    </script>
</body>
</html>
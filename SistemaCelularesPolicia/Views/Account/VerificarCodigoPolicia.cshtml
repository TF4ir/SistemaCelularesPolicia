@{
    Layout = null;
    string email = ViewBag.Email as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Verificar Policía</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card border-0 shadow-lg rounded-4 my-5">
                    <div class="card-body p-5 text-center">

                        <div class="icon-circle-box bg-success-subtle text-police mb-3 d-inline-flex p-3 rounded-circle">
                            <i class="bi bi-shield-check fs-1"></i>
                        </div>

                        <h3 class="fw-bold text-police mb-2">Verificación Policial</h3>
                        <p class="text-muted mb-4">
                            Ingrese el código enviado a su correo institucional: <br />
                            <strong>@email</strong>
                        </p>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger small">@ViewBag.Error</div>
                        }

                        <form asp-action="VerificarCodigoPolicia" method="post">
                            <input type="hidden" name="email" value="@email" />

                            <div class="mb-4">
                                <div class="input-with-icon position-relative">
                                    <i class="bi bi-key position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                    <input name="codigo" class="form-control ps-5 text-center fw-bold fs-5 tracking-widest"
                                           placeholder="000000" maxlength="6" required style="letter-spacing: 5px;" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-police w-100 py-3 fw-bold shadow-sm">
                                Verificar Credenciales
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
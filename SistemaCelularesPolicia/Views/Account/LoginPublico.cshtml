@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Acceso Público</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-app">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card p-4">
                    <div class="card-body">
                        <div class="mb-4">
                            <a asp-controller="Home" asp-action="Index" class="link-back">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                        </div>

                        <div class="text-center mb-4">
                            <i class="bi bi-person-circle text-public" style="font-size: 3.5rem;"></i>
                            <h4 class="fw-bold mt-3 mb-1 text-dark">Acceso Público</h4>
                            <p class="text-muted small">Inicie sesión para consultar celulares</p>
                        </div>

                        <form method="post">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">Correo Electrónico</label>
                                <div class="input-with-icon">
                                    <i class="bi bi-envelope"></i>
                                    <input type="email" name="email" class="form-control" placeholder="correo@ejemplo.com" required>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-bold text-secondary">Contraseña</label>
                                <div class="input-with-icon">
                                    <i class="bi bi-lock"></i>
                                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                                </div>
                            </div>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger py-2 small text-center mb-3">
                                    @ViewBag.Error
                                </div>
                            }

                            <button type="submit" class="btn btn-public w-100 mb-4 py-3">
                                Ingresar
                            </button>

                            <div class="text-center">
                                <p class="text-muted small mb-1">¿No tiene una cuenta?</p>
                                <a asp-controller="Account" asp-action="RegisterPublico" class="link-public small">
                                    Registrarse ahora
                                </a>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
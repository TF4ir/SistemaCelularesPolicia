@model IEnumerable<SistemaCelularesPolicia.Models.PersonalPolicial>

@{
    ViewData["Title"] = "Directorio Policial";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-police fw-bold">Administración de Personal</h2>
            <p class="text-muted">Gestión de usuarios, asignación de roles y seguridad.</p>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Oficial</th>
                            <th class="text-secondary text-uppercase small fw-bold">CIP</th>
                            <th class="text-secondary text-uppercase small fw-bold">Unidad</th>
                            <th class="text-secondary text-uppercase small fw-bold">Rol de Acceso</th>
                            <th class="text-end pe-4 text-secondary text-uppercase small fw-bold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.RangoGrado @item.Nombres @item.Apellidos</div>
                                    <small class="text-muted"><i class="bi bi-envelope me-1"></i>@item.EmailInstitucional</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.CodigoPolicial</span></td>
                                <td>@item.UnidadDependencia</td>
                                <td>
                                    @if (item.IdRolNavigation != null)
                                    {
                                        <span class="badge bg-police">@item.IdRolNavigation.NombreRol</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Sin Rol</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="AsignarRol" asp-route-id="@item.IdPolicial" class="btn btn-sm btn-outline-dark" title="Cambiar Rol">
                                            <i class="bi bi-person-gear"></i> <span class="d-none d-md-inline">Rol</span>
                                        </a>

                                        <form asp-action="Resetear2FA" asp-route-id="@item.IdPolicial" method="post" class="m-0"
                                              onsubmit="return confirm('¿ESTÁ SEGURO?\n\nEsto borrará la configuración de Google Authenticator del efectivo @item.Nombres @item.Apellidos.\nDeberá escanear un nuevo código QR en su próximo inicio de sesión.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Reiniciar 2FA">
                                                <i class="bi bi-shield-x"></i> <span class="d-none d-md-inline">2FA</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
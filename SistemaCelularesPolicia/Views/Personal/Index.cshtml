@model IEnumerable<SistemaCelularesPolicia.Models.PersonalPolicial>

@{
    ViewData["Title"] = "Directorio Policial";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-police fw-bold">Administración de Personal</h2>
            <p class="text-muted">Gestión de usuarios y asignación de roles.</p>
        </div>
    </div>
    
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Oficial</th>
                        <th class="text-secondary text-uppercase small fw-bold">CIP</th>
                        <th class="text-secondary text-uppercase small fw-bold">Unidad</th>
                        <th class="text-secondary text-uppercase small fw-bold">Rol de Acceso</th>
                        <th class="text-end pe-4 text-secondary text-uppercase small fw-bold">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.RangoGrado @item.Nombres @item.Apellidos</div>
                                <small class="text-muted"><i class="bi bi-envelope me-1"></i>@item.EmailInstitucional</small>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.CodigoPolicial</span></td>
                            <td>@item.UnidadDependencia</td>
                            <td>
                                @if (item.IdRolNavigation != null)
                                {
                                    <span class="badge bg-police">@item.IdRolNavigation.NombreRol</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sin Rol</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="AsignarRol" asp-route-id="@item.IdPolicial" class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-person-gear"></i> Cambiar Rol
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>